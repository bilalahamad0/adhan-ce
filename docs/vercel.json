{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "redirects": [
    {
      "source": "/:path*",
      "has": [{ "type": "host", "value": "adhan-ce.vercel.app" }],
      "destination": "https://adhan.bilalahamad.com/:path*",
      "permanent": true
    },
    {
      "source": "/adhan-ce",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/adhan-ce/",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/adhan-ce/:path*",
      "destination": "/:path*",
      "permanent": true
    },
    {
      "source": "/adhan",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/adhan/",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/adhan/:path*",
      "destination": "/:path*",
      "permanent": true
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" }
      ]
    },
    {
      "source": "/store/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=86400, stale-while-revalidate=604800" }
      ]
    },
    {
      "source": "/icon128.png",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=86400, stale-while-revalidate=604800" }
      ]
    }
  ]
}
